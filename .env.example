# ============================================================
# 环境变量模板（复制为 .env 并填入真实值）
# cp .env.example .env
# ============================================================

# Spring Boot 运行环境（本地可用 local，服务器建议 prod）
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8090
SERVER_ADDRESS=0.0.0.0

# 数据库
DB_URL=jdbc:mysql://localhost:3306/teaching_competition?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=123456

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT
JWT_SECRET=TeachingCompetitionSystemSecretKeyForJwtToken2024!@#$%^&*()
JWT_EXPIRATION=86400000

# CORS（多个域名用逗号分隔，生产可填你的前端域名/IP）
APP_CORS_ALLOWED_ORIGIN_PATTERNS=*

# 本地文件存储
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_PATH=/opt/teaching-competition/uploads
FILE_STORAGE_DOMAIN=

# 阿里云 OSS
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET_NAME=your-bucket-name
OSS_DOMAIN=
